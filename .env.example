# Cloudflare R2 & Backend Configuration Example
VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
VITE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
VITE_CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_CLOUDFLARE_R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
VITE_CLOUDFLARE_R2_BUCKET=systemsaviour-data
VITE_CLOUDFLARE_WORKER_URL=https://systemsaviour-backend.systemsaviour-backend.workers.dev
